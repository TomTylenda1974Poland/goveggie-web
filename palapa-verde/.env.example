# Proveedor de datos de comercio: "mock" (datos de prueba, por defecto) o "goveggie".
COMMERCE_PROVIDER=mock

# API de goveggie.life — se rellenan cuando llegue la especificación. Nunca subir valores reales al repo.
GOVEGGIE_API_URL=
GOVEGGIE_API_KEY=

# Pon "true" solo al lanzar: permite que Google indexe el sitio.
SITE_INDEXABLE=false

# Pedidos en línea: desactivados. Solo poner "true" cuando el negocio lo decida.
ORDERS_ENABLED=false

# Recetas en borrador: visibles en previsualización, ocultas en producción salvo "true".
SHOW_DRAFT_RECIPES=

# Dominio público de producción (metadatos, sitemap y QR). Ej.: https://palapaverde.do
SITE_URL=

# Proveedor de analítica aprobado (solo informativo para /admin), p. ej. "gtm".
NEXT_PUBLIC_ANALYTICS_PROVIDER=
